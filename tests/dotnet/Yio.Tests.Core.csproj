<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Yio.Tests.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>

    <!-- FrameBlob 中性化后用自有类型（YioVector2/YioColor）——带 Public/Yio.Types.cs
         依赖（该文件纯 System，无引擎引用；本工程无 stub，编过即纯度门）。 -->
    <Compile Include="..\..\unity\package\Runtime\Core\Public\Yio.Types.cs" Link="Src\Yio.Types.cs" />
    <Compile Include="..\..\unity\package\Runtime\Core\FrameBlob.cs" Link="Src\FrameBlob.cs" />
    <!-- golden 跨语言对拍 fixture（Rust ffi golden_tests 产器落盘；
         再生成方式见 crates/ffi/src/golden_tests.rs 模块注释） -->
    <None Include="golden\*.bin" Link="golden\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 排除独立 csproj 子目录：SDK 默认 **/*.cs glob 会误扫 HeadlessTests / PublicApi，
       它们有自己的 csproj + 依赖（unsafe / Bindings），扫进 Tests.Core 会编译失败。 -->
  <ItemGroup>
    <Compile Remove="Yio.HeadlessTests\**\*.cs" />
    <Compile Remove="Yio.PublicApi\**\*.cs" />
  </ItemGroup>

</Project>
