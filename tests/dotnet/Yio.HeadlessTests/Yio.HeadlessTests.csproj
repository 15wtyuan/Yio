<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Yio.HeadlessTests</RootNamespace>
  </PropertyGroup>

  <!--
    B3 范围：在 B1 纯 managed 基础上扩展 native P/Invoke。直接 Compile Include
    Public/*.cs + Projection/*.cs + Bindings/*.cs 编进测试程序集（不走 ProjectReference），
    所以 internal CssValueConvert / Native / StageHandle 等对 Harness 可见。
    Native dll（yio_ffi_c.dll）随测试拷到输出目录，P/Invoke 才加载得到
    （.NET 默认从 base dir 探 native library；CopyToOutputDirectory 把它放那）。
    PackageReference 版本对齐 tests/dotnet/Yio.Tests.Core.csproj（不自己造版本号）。
    AllowUnsafeBlocks：Bindings 是 csbindgen 生成的 unsafe P/Invoke + 指针类型。
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\unity\package\Runtime\Core\Public\Yio.*.cs" Link="Public\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\unity\package\Runtime\Core\Projection\*.cs" Link="Projection\%(Filename)%(Extension)" />
    <!-- 引擎无关机械门（#14 前重构）：Host/（YioHost+YioBackend）+ FrameBlob + YioManifests
         必须在本工程（无 UnityEngine）零 stub 编过——这是「中性层不渗引擎类型」的唯一编译期
         兜底（Unity asmdef 永远隐式引 UnityEngine，挡不住渗漏；历史教训：FrameBlob 曾靠
         tests/dotnet/Stubs/UnityEngine.cs 假类型圆谎）。 -->
    <Compile Include="..\..\..\unity\package\Runtime\Core\Host\*.cs" Link="Host\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\unity\package\Runtime\Core\FrameBlob.cs" Link="FrameBlob.cs" />
    <Compile Include="..\..\..\unity\package\Runtime\Core\YioManifests.cs" Link="YioManifests.cs" />
    <!-- csbindgen P/Invoke 声明（Native）+ 手补 #[repr(C)] 镜像 struct（PointerEvent/KeyEvent/WheelEvent）。
         YioBindings.cs 引用后三者作 *PointerEvent 等参数类型，必须一并编进同一程序集。 -->
    <Compile Include="..\..\..\unity\package\Plugins\Yio\Bindings\*.cs" Link="Bindings\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\unity\package\Plugins\Yio\yio_ffi_c.dll" Link="yio_ffi_c.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- E2 fixture pkg.bin for LoadPackage/Instantiate end-to-end tests (E3 acceptance gate) -->
    <None Include="fixtures\test.pkg.bin" Link="fixtures\test.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- P1 C2 fixture: p1-block-acceptance (display:block + flex-grow:1 children) — used by BlockLayoutTests.
         Built from fixtures/p1-block.workspace via yio-pkg; output copied here as a git-tracked fixture. -->
    <None Include="fixtures\p1-block.pkg.bin" Link="fixtures\p1-block.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- P1 control bundle fixture: controls.pkg.bin (progress/slider/toggle/radio with baked
         ControlState) — used by ControlProjectionTests for value/checked FFI round-trip.
         Built from fixtures/controls.workspace via yio-pkg. -->
    <None Include="fixtures\controls.pkg.bin" Link="fixtures\controls.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- P2-A fixture: p2-visual-acceptance (border-radius + border / box-shadow) — used by VisualDecorationTests.
         Built from fixtures/p2-visual.workspace via yio-pkg; output copied here as a git-tracked fixture. -->
    <None Include="fixtures\p2-visual.pkg.bin" Link="fixtures\p2-visual.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- box-shadow visual bundle fixture: box-shadow-acceptance (multi-layer outer + inset + blur) —
         used by BoxShadowTests for the frame-blob synth-node/program/shadow_params assertion.
         Built from fixtures/box-shadow.workspace via yio-pkg; output copied here as a git-tracked fixture. -->
    <None Include="fixtures\box-shadow.pkg.bin" Link="fixtures\box-shadow.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- P2 TextField projection fixture: textfield.pkg.bin (TextField/TextArea
         with baked EditState) — used by TextFieldProjectionTests for value/placeholder/selection
         FFI round-trip + Submitted/textinput via set_key_input/set_text_input. Built from
         fixtures/textfield.workspace via yio-pkg. -->
    <None Include="fixtures\textfield.pkg.bin" Link="fixtures\textfield.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Task 8 dropdown/option projection fixture: dropdown.pkg.bin (select with option children +
         slot + custom-element) — used by OptionItemDispatchTests for NodeFactory dispatch to
         OptionItem/Slot/CustomElement (vs Container fallback). Built from fixtures/dropdown.workspace. -->
    <None Include="fixtures\dropdown.pkg.bin" Link="fixtures\dropdown.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Named-template fixture: templates.pkg.bin (container with <template id="row-tpl"> blueprint) —
         used by SchedulerAndLifecycleTests for Container.GetTemplate → UITemplate.Instantiate cloning. -->
    <None Include="fixtures\templates.pkg.bin" Link="fixtures\templates.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- M3 Task 9 tablist projection fixture: tablist.pkg.bin (div role=tablist with tab children +
         tabpanel siblings) — used by TabListProjectionTests for SelectedIndex FFI round-trip +
         NodeFactory dispatch (TabList/Tab) + SelectionChanged via demux. Built from
         fixtures/tablist.workspace via yio-pkg. -->
    <None Include="fixtures\tablist.pkg.bin" Link="fixtures\tablist.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- M1 ListView virtualization fixture: virtualization.pkg.bin (overflow:scroll pane > ul > li
         template) — used by VirtualizationTests for the no-growth render-node-count assertion.
         Built from fixtures/virtualization.workspace via yio-pkg. -->
    <None Include="fixtures\virtualization.pkg.bin" Link="fixtures\virtualization.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- M1 Task 6 variable-height fixture: varheight.pkg.bin (overflow:scroll pane > ul > li with
         height:auto + margin-bottom) — used by VirtualizationTests.VariableHeight_NoDrift for the
         anchoring no-drift assertion. Built from fixtures/varheight.workspace via yio-pkg. -->
    <None Include="fixtures\varheight.pkg.bin" Link="fixtures\varheight.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- M2 Task 13 animation handle fixture: animation.pkg.bin (@keyframes fade + hookanim with
         @yio-hook "half" on the 50% stop) — used by AnimationHandleTests for the programmatic
         node.Play L3 suite (Play/Pause/Resume/Stop/Time + OnStart/OnEnd/OnKey/OnHook +
         On<AnimationEndEvent>). Built from fixtures/animation.workspace via yio-pkg. -->
    <None Include="fixtures\animation.pkg.bin" Link="fixtures\animation.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- M3 #12 multi-template fixture: multitpl.pkg.bin (pane > list with two <template id>
         blueprints of distinct baked heights) — used by MultiTemplateTests for TemplateSelector
         per-item dispatch / strict null / no-selection throw / pre-enter ItemTemplate buffering.
         Built from fixtures/multitpl.workspace via yio-pkg. -->
    <None Include="fixtures\multitpl.pkg.bin" Link="fixtures\multitpl.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- E2 fixture font for text layout (tick panics without a default font) -->
    <None Include="fixtures\fonts\DejaVuSans.ttf" Link="fixtures\fonts\DejaVuSans.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Component system fixture: component.pkg.bin (page with 2 expanded game-item-card hosts +
         slot-projected buttons; components/game-item-card.html carries its own <style>). Built from
         fixtures/component.workspace via yio-pkg (components/ registry expansion, pkg v35). -->
    <None Include="fixtures\component.pkg.bin" Link="fixtures\component.pkg.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- golden 跨语言对拍 fixture（Rust ffi golden_tests 产器落盘的真实 frame blob + 事件流，
         GoldenEventsAndAbiLayoutTests 消费；再生成方式见 crates/ffi/src/golden_tests.rs 模块注释） -->
    <None Include="..\golden\*.bin" Link="golden\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
